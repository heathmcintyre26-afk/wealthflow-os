# Wealthflow OS Production Environment Variables

# Admin Configuration
ADMIN_SECRET=your-secure-admin-token-here

# Treasury & Wallet
WALLET_ADDRESS=0x47cdb61e41b7806Ab23B5d4C1296aacC11cAD489

# PayPal Live Merchant Credentials
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# Session Management
SESSION_SECRET=your-long-secure-random-session-secret

# Email Receipts (Optional)
RESEND_API_KEY=your-resend-api-key

# Database (Optional - for persistent ledger)
DATABASE_URL=your-database-connection-string

# Feature Flags
ENABLE_PAYPAL_LIVE=true
ENABLE_EMAIL_RECEIPTS=false
ENABLE_PERSISTENT_STORAGE=false
